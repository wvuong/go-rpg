# Binaries for programs
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, can be ignored
*.test

# Go workspace file
go.work.lock

# Optional: Vendor directory (depends on project practices)
vendor/

# Environment files
.env

# IDE-related files and directories (common examples)
# Keep comments on their own line: git only treats # as a comment at the start
# of a line, so a trailing "# note" becomes part of the pattern and matches nothing.
# for GoLand/IntelliJ
.idea/
# for VS Code
.vscode/
.history/
*.swp

.DS_Store

*.tiled-session